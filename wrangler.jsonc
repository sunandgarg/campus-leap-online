{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dekhocampus-online",
  "account_id": "5763dba3e739e1dbfd40501d9358caaa",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"],
    },
  ],
  "routes": [
    {
      "pattern": "online.dekhocampus.com",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "dekhocampus-online",
      "database_id": "c369d047-e240-4832-baa5-8d80cc266ec4",
      "migrations_dir": "migrations",
    },
  ],
  // R2 is not enabled in this account. Reviewed media ships as cached static assets.
  "vars": {
    "TURNSTILE_ALLOWED_HOSTNAMES": "online.dekhocampus.com",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
}
