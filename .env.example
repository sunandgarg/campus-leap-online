# Browser-safe Supabase values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server runtime values
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Required only by trusted server-side admin operations. Never prefix this
# value with VITE_ and never expose it to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public Turnstile widget identifier. Safe to expose to the browser.
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Server-only Turnstile credential. Production lead intake fails closed when
# either Turnstile value is missing. Never prefix this value with VITE_.
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
TURNSTILE_ALLOWED_HOSTNAMES=online.dekhocampus.in

# A separate random secret (at least 32 characters) used to HMAC the client
# network bucket before rate limiting. Raw network addresses are never stored.
LEAD_BUCKET_SECRET=YOUR_RANDOM_32_BYTE_SECRET
