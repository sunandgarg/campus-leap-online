# Public Turnstile widget identifier. Safe to expose to the browser.
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Server-only Turnstile credential. Production lead intake fails closed when
# either Turnstile value is missing. Never prefix this value with VITE_.
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY
TURNSTILE_ALLOWED_HOSTNAMES=online.dekhocampus.com

# A separate random secret (at least 32 characters) used to HMAC the client
# network bucket before rate limiting. Raw network addresses are never stored.
LEAD_BUCKET_SECRET=YOUR_RANDOM_32_BYTE_SECRET
# Public canonical domain. Set this when choosing a new production domain.
VITE_SITE_URL=https://online.dekhocampus.com

# Admin routes remain locked until a staff-only Cloudflare Access application
# is configured and its issuer and audience are supplied as Worker variables.
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# ACCESS_POLICY_AUD=YOUR_STAFF_APPLICATION_AUD
